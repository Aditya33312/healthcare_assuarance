{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatekeeper.health/schemas/contracts/entity/1.0.0",
  "title": "Gatekeeper Clinical Entity Contract",
  "description": "Version 1.0.0 contract for one evidence-linked clinical entity extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "type",
    "text",
    "assertion",
    "temporality",
    "subject",
    "certainty",
    "laterality",
    "normalized_value",
    "normalized_unit",
    "source_span",
    "confidence",
    "extractor",
    "extractor_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "entity_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "type": { "$ref": "#/$defs/entityType" },
    "text": { "type": "string", "minLength": 1 },
    "assertion": { "$ref": "#/$defs/assertionStatus" },
    "temporality": { "enum": ["CURRENT", "HISTORICAL", "FUTURE", "UNKNOWN"] },
    "subject": { "$ref": "#/$defs/subjectType" },
    "certainty": { "enum": ["CERTAIN", "PROBABLE", "POSSIBLE", "UNCERTAIN"] },
    "laterality": {
      "enum": ["LEFT", "RIGHT", "BILATERAL", "MIDLINE", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "normalized_value": {
      "type": ["string", "number", "null"]
    },
    "normalized_unit": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "source_span": { "$ref": "#/$defs/textSpan" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "extractor": { "type": "string", "minLength": 1 },
    "extractor_version": { "$ref": "#/$defs/semanticVersion" }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entityType": {
      "enum": [
        "CONDITION",
        "SYMPTOM",
        "MEDICATION",
        "DOSE",
        "UNIT",
        "FREQUENCY",
        "ROUTE",
        "PROCEDURE",
        "BODY_SITE",
        "LATERALITY",
        "ALLERGY",
        "LAB_TEST",
        "LAB_VALUE",
        "DATE",
        "TIME",
        "DURATION",
        "AGE"
      ]
    },
    "assertionStatus": {
      "enum": [
        "PRESENT",
        "ABSENT",
        "POSSIBLE",
        "HISTORICAL",
        "FAMILY_HISTORY",
        "HYPOTHETICAL",
        "CONDITIONAL",
        "UNCERTAIN"
      ]
    },
    "subjectType": { "enum": ["PATIENT", "FAMILY", "OTHER_PERSON", "UNKNOWN"] },
    "textSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "document_id": { "type": ["string", "null"], "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
