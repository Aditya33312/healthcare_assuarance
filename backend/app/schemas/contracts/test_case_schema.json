{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatekeeper.health/schemas/contracts/test-case/1.0.0",
  "title": "Gatekeeper Test Case Contract",
  "description": "Version 1.0.0 test case envelope shared by all Gatekeeper test families.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_case_id",
    "test_case_version",
    "name",
    "test_family",
    "risk_tier",
    "input",
    "expectation",
    "tags",
    "provenance",
    "active"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "test_case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "test_case_version": { "$ref": "#/$defs/semanticVersion" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1 },
    "test_family": {
      "enum": [
        "CLINICAL_FAITHFULNESS",
        "CLINICAL_NOTE_GENERATION",
        "CLINICAL_TASK_PERFORMANCE",
        "MEDICATION_SAFETY",
        "NEGATION_ASSERTION",
        "OMISSION_DETECTION",
        "ROBUSTNESS",
        "DEMOGRAPHIC_BIAS",
        "MEDICAL_COGNITIVE_BIAS",
        "SAFETY_REFUSAL",
        "PROMPT_INJECTION_JAILBREAK",
        "MODEL_DATA_EXTRACTION",
        "RAG_GROUNDING",
        "RAG_POISONING",
        "REGULATORY_POLICY_HARDENING",
        "CUSTOM_BUSINESS_REGRESSION"
      ]
    },
    "risk_tier": { "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"] },
    "input": { "$ref": "#/$defs/testInput" },
    "expectation": { "$ref": "https://gatekeeper.health/schemas/contracts/expectation/1.0.0" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
      "uniqueItems": true
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "active": { "type": "boolean" }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "type", "content"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/clinicalArtifactType" },
        "content": { "$ref": "#/$defs/evidenceContent" }
      }
    },
    "retrievedChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "content", "trusted"],
      "properties": {
        "chunk_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "trusted": { "type": "boolean" }
      }
    },
    "generatedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "type", "content"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/clinicalArtifactType" },
        "content": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "patternProperties": { ".*": {} }
            }
          ]
        }
      }
    },
    "clinicalArtifactType": {
      "enum": [
        "clinical_text",
        "clinical_transcript",
        "clinical_note",
        "clinical_summary",
        "clinical_letter",
        "discharge_summary",
        "referral_letter",
        "patient_message",
        "question",
        "document",
        "structured_data",
        "audio_transcript",
        "image_report",
        "multimodal_text",
        "answer",
        "recommendation",
        "tool_action",
        "other"
        ,"transcript"
        ,"lab_results"
        ,"medication_list"
        ,"structured_json"
        ,"rag_context"
      ]
    },
    "evidenceContent": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": { ".*": {} }
        }
      ]
    },
    "testInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_documents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceDocument" }
        },
        "prompt": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "generated_output": { "$ref": "#/$defs/generatedOutput" },
        "retrieved_chunks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retrievedChunk" }
        },
        "perturbation": { "type": "string", "minLength": 1 },
        "policy_context": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["source_documents"] },
        { "required": ["prompt"] },
        { "required": ["retrieved_chunks"] }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classification", "contains_phi", "authoring_method"],
      "properties": {
        "data_classification": { "enum": ["SYNTHETIC", "DE_IDENTIFIED"] },
        "contains_phi": { "const": false },
        "no_phi_attested": { "const": true },
        "attested_by_user_id": { "type": "string", "minLength": 1 },
        "attested_at": { "type": "string", "format": "date-time" },
        "authoring_method": { "enum": ["MANUAL", "CLINICIAN_AUTHORED", "SME_AUTHORED"] },
        "source_reference": { "type": "string", "minLength": 1 }
      }
    }
  }
}
