{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatekeeper.health/schemas/contracts/assertion/1.0.0",
  "title": "Gatekeeper Clinical Assertion Contract",
  "description": "Version 1.0.0 contract for assertion, subject, and scope classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertion_id",
    "status",
    "subject",
    "temporality",
    "certainty",
    "cue",
    "scope",
    "confidence",
    "detector",
    "detector_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assertion_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "status": {
      "enum": [
        "PRESENT",
        "ABSENT",
        "POSSIBLE",
        "HISTORICAL",
        "FAMILY_HISTORY",
        "HYPOTHETICAL",
        "CONDITIONAL",
        "UNCERTAIN"
      ]
    },
    "subject": { "enum": ["PATIENT", "FAMILY", "OTHER_PERSON", "UNKNOWN"] },
    "temporality": { "enum": ["CURRENT", "HISTORICAL", "FUTURE", "UNKNOWN"] },
    "certainty": { "enum": ["CERTAIN", "PROBABLE", "POSSIBLE", "UNCERTAIN"] },
    "cue": {
      "oneOf": [
        { "$ref": "#/$defs/textSpan" },
        { "type": "null" }
      ]
    },
    "scope": { "$ref": "#/$defs/textSpan" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "detector": { "type": "string", "minLength": 1 },
    "detector_version": { "$ref": "#/$defs/semanticVersion" }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "textSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "document_id": { "type": ["string", "null"], "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
