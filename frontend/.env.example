GATEKEEPER_API_URL=http://localhost:8000
# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
GATEKEEPER_API_KEY=gk_test_replace_me
# Required as a pair in production. The trusted gateway must remove this header
# from inbound traffic and inject a private value generated with:
# openssl rand -hex 32
GATEKEEPER_PORTAL_TRUSTED_HEADER=
GATEKEEPER_PORTAL_TRUSTED_VALUE=
# Required for writes in production; exact HTTPS origin, without a path.
GATEKEEPER_PORTAL_ALLOWED_ORIGIN=
GATEKEEPER_PORTAL_WRITES_ENABLED=false
