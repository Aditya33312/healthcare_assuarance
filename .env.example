GATEKEEPER_ENVIRONMENT=development
# Local development credentials only; production rejects this public password.
GATEKEEPER_DATABASE_URL=postgresql+psycopg://gatekeeper:gatekeeper@localhost:5432/gatekeeper
# Development placeholder only; production rejects placeholder-shaped peppers.
# Generate a deployment value with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
GATEKEEPER_API_KEY_PEPPER=replace-with-a-long-random-secret
# This intentionally invalid placeholder forces developers to generate a Fernet key.
GATEKEEPER_DATA_ENCRYPTION_KEYS=generate-a-fernet-key-and-rotate-with-comma-separated-old-keys
# JSON escaping can expand the HTTP envelope; decoded clinical evidence is
# independently limited below.
GATEKEEPER_MAX_REQUEST_BYTES=8388608
GATEKEEPER_MAX_SOURCE_COUNT=100
GATEKEEPER_MAX_SOURCE_BYTES=1048576
GATEKEEPER_MAX_GENERATED_OUTPUT_BYTES=1048576
GATEKEEPER_MAX_TOTAL_EVIDENCE_BYTES=2097152
GATEKEEPER_MAX_TRANSCRIPT_SEGMENTS=10000
GATEKEEPER_MAX_STRUCTURED_DEPTH=32
GATEKEEPER_MAX_JSON_ARRAY_ITEMS=100000
GATEKEEPER_MAX_CANONICAL_EVIDENCE_UNITS=25000
GATEKEEPER_MAX_EXTRACTED_CLAIMS=50000
GATEKEEPER_MAX_PROCESSING_SECONDS=120
GATEKEEPER_SMALL_BYTES=10240
GATEKEEPER_MEDIUM_BYTES=102400
GATEKEEPER_LARGE_BYTES=1048576
GATEKEEPER_CHUNK_CHARACTERS=12000
GATEKEEPER_CHUNK_OVERLAP_CHARACTERS=500
GATEKEEPER_MAX_CHUNKS=5000
GATEKEEPER_NER_BACKEND=rules
GATEKEEPER_NER_MODEL=d4data/biomedical-ner-all
GATEKEEPER_NER_MODEL_REVISION=015a4050c9ac99722e61c547aa9b4282bcbedc7f
# Opt-in advisory planner. It proposes applicable test families but deterministic
# Gatekeeper rules remain authoritative and the release policy remains in control.
GATEKEEPER_LLM_PLANNER_ENABLED=false
GATEKEEPER_LLM_PROVIDER=anthropic
# Set this only when enabling the planner; do not commit an API key.
GATEKEEPER_LLM_MODEL=
# Keep this secret in a local .env or a secret manager; never commit it.
GATEKEEPER_ANTHROPIC_API_KEY=
GATEKEEPER_LLM_TIMEOUT_SECONDS=30
# Reserved fail-closed setting: true is rejected until a runtime semantic evaluator exists.
GATEKEEPER_SEMANTIC_EVALUATION_ENABLED=false
